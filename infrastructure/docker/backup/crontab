# Crontab for automated database backups
#
# Schedule: Daily backups at 2:00 AM UTC
# Retention: Managed by backup script (default: 30 days)
#
# Format:
# ┌───────────── minute (0 - 59)
# │ ┌───────────── hour (0 - 23)
# │ │ ┌───────────── day of month (1 - 31)
# │ │ │ ┌───────────── month (1 - 12)
# │ │ │ │ ┌───────────── day of week (0 - 6) (Sunday to Saturday)
# │ │ │ │ │
# │ │ │ │ │
# * * * * * command to execute

# Daily full backup at 2:00 AM UTC
0 2 * * * /usr/local/bin/backup_database.sh daily_backup_$(date +\%Y\%m\%d) >> /backups/backup.log 2>&1

# Weekly backup every Sunday at 3:00 AM UTC
0 3 * * 0 /usr/local/bin/backup_database.sh weekly_backup_$(date +\%Y\%m\%d) >> /backups/backup.log 2>&1

# Monthly backup on the 1st of each month at 4:00 AM UTC
0 4 1 * * /usr/local/bin/backup_database.sh monthly_backup_$(date +\%Y\%m\%d) >> /backups/backup.log 2>&1

# Hourly backup (for RPO of 1 hour) - runs every hour
0 * * * * /usr/local/bin/backup_database.sh hourly_backup_$(date +\%Y\%m\%d_\%H\%M) >> /backups/backup.log 2>&1

# Log rotation for backup logs - clean logs older than 7 days every day at 1:00 AM
0 1 * * * find /backups -name "*.log" -type f -mtime +7 -delete
