# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Set this to 'development', 'staging', or 'production'
NODE_ENV=development
APP_ENV=development

# ============================================================================
# BACKEND CONFIGURATION (Railway)
# ============================================================================

# Database Configuration
# Local development: Use these values
# Railway production: Use ${{Postgres.PGUSER}}, ${{Postgres.PGPASSWORD}}, etc.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipe_app

# Railway Database URL (alternative to individual settings)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Application Settings
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# Railway: Use ${{PORT}} or Railway will auto-assign

# Security Keys
# IMPORTANT: Generate secure keys for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# CORS Configuration
# Development: Allow all origins with *
# Production: Comma-separated list of allowed origins
# Example: https://your-app.vercel.app,https://custom-domain.com
CORS_ORIGINS=*

# ============================================================================
# FRONTEND CONFIGURATION (Vercel)
# ============================================================================

# Backend API URL
# Local development: http://localhost:8000
# Vercel production: https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend URL (used for CORS and redirects)
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# ============================================================================
# ROHLIK/KNUSPR MCP SERVER CONFIGURATION
# ============================================================================

# Choose MCP Server Mode: 'local' or 'remote'
# - local: Run your own MCP server (https://github.com/davidraehles/rohlik-mcp)
# - remote: Use hosted MCP server at https://mcp.rohlik.cz/mcp
ROHLIK_MCP_MODE=local

# --- Local MCP Server Configuration ---
# Used when ROHLIK_MCP_MODE=local
ROHLIK_MCP_BASE_URL=http://localhost:3000
ROHLIK_USERNAME=your-rohlik-email@example.com
ROHLIK_PASSWORD=your-rohlik-password
ROHLIK_COUNTRY=CZ  # CZ for Czech Republic, DE for Germany, etc.

# --- Remote MCP Server Configuration ---
# Used when ROHLIK_MCP_MODE=remote
# The remote server is at: https://mcp.rohlik.cz/mcp
ROHLIK_MCP_REMOTE_URL=https://mcp.rohlik.cz/mcp
RHL_EMAIL=your-rohlik-email@example.com
RHL_PASS=your-rohlik-password

# Common Rohlik/Knuspr Settings
# Country codes: CZ (Czech), DE (Germany), AT (Austria), HU (Hungary)
ROHLIK_DEFAULT_COUNTRY=CZ

# Redis Configuration
# For Railway, use: ${{Redis.REDIS_HOST}}, ${{Redis.REDIS_PORT}}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO

# Rate Limiting Configuration
# Limits are per user per minute
RATE_LIMIT_CART_CREATION=10      # Knuspr cart creation operations
RATE_LIMIT_CART_UPDATES=20        # Cart update operations
RATE_LIMIT_PRODUCT_SEARCHES=30    # Product search operations
RATE_LIMIT_DEFAULT=60             # Default limit for other endpoints

# HTTPS & Security Configuration
ENFORCE_HTTPS=false                          # Set to 'true' in production to redirect HTTP to HTTPS
HSTS_MAX_AGE=31536000                        # HSTS max age in seconds (1 year)
HSTS_INCLUDE_SUBDOMAINS=true                 # Include subdomains in HSTS
HSTS_PRELOAD=false                           # Enable HSTS preload (requires careful setup)
CSP_ENABLED=false                            # Enable Content Security Policy
CSP_POLICY=default-src 'self'                # CSP policy (if enabled)
PERMISSIONS_POLICY=geolocation=(), camera=() # Browser permissions policy
