# Database Configuration
# For Railway, use: ${{Postgres.PGUSER}}, ${{Postgres.PGPASSWORD}}, etc.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipe_app

# Application Settings
APP_ENV=development
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# For Railway, use: ${{PORT}}

# Security
# IMPORTANT: Generate secure keys for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# CORS Configuration
# For production, set to your frontend URL(s): https://your-app.vercel.app,https://custom-domain.com
CORS_ORIGINS=*

# External Services
# Knuspr API (optional for development)
KNUSPR_API_KEY=

# Redis Configuration
# For Railway, use: ${{Redis.REDIS_HOST}}, ${{Redis.REDIS_PORT}}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO

# Monitoring & Observability
# Grafana Configuration (REQUIRED for production - change default credentials!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Sentry Error Tracking (optional - set DSN to enable)
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
