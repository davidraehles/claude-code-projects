# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Environment: 'development', 'staging', or 'production'
NODE_ENV=development

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Backend API URL
# Local development: http://localhost:8000
# Railway production: https://meal-planner.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (if different from API URL)
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend Application URL
# Local development: http://localhost:3000
# Vercel production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# AUTHENTICATION (NextAuth.js)
# ============================================================================

# NextAuth Secret Key
# Generate with: openssl rand -base64 32
# REQUIRED for production deployments
NEXTAUTH_SECRET=your-secret-here-change-in-production

# NextAuth URL
# Should match your deployment URL
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (auto-detected on Vercel)
NEXTAUTH_URL=http://localhost:3000

# JWT Token Configuration
NEXTAUTH_JWT_SECRET=your-jwt-secret-here-change-in-production

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Analytics (e.g., Google Analytics, Plausible)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable Debug Mode (shows additional logging in browser)
NEXT_PUBLIC_ENABLE_DEBUG=true

# Enable Knuspr/Rohlik Integration
NEXT_PUBLIC_ENABLE_KNUSPR=true

# Enable AI Meal Planning Features
NEXT_PUBLIC_ENABLE_AI_MEAL_PLANNER=true

# ============================================================================
# ROHLIK/KNUSPR CONFIGURATION
# ============================================================================

# Default Country for Knuspr/Rohlik
# Options: CZ (Czech Republic), DE (Germany), AT (Austria), HU (Hungary)
NEXT_PUBLIC_DEFAULT_COUNTRY=DE

# Knuspr/Rohlik MCP Server Mode
# 'local': Use local MCP server (requires rohlik-mcp running locally)
# 'remote': Use remote hosted MCP server at https://mcp.rohlik.cz/mcp
NEXT_PUBLIC_ROHLIK_MCP_MODE=local

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================

# Sentry DSN (Error Tracking)
# NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=

# Plausible Analytics Domain
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# OpenAI API Key (for AI features - backend only, not exposed)
# OPENAI_API_KEY=

# Image Upload Service (e.g., Cloudinary, S3)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Show React Query Devtools
NEXT_PUBLIC_SHOW_DEVTOOLS=true

# Mock API Responses (for development without backend)
NEXT_PUBLIC_MOCK_API=false

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to Vercel, ensure you:
# 1. Set NEXTAUTH_SECRET to a secure random value
# 2. Set NEXTAUTH_URL to your Vercel deployment URL
# 3. Set NEXT_PUBLIC_API_URL to your Railway backend URL
# 4. Set NEXT_PUBLIC_APP_URL to your Vercel deployment URL
# 5. Disable debug features (NEXT_PUBLIC_ENABLE_DEBUG=false)
# 6. Configure CORS_ORIGINS in backend to include your frontend URL
# ============================================================================
