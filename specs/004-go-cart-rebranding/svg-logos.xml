<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600">
  <defs>
    <!-- Brand Gradient -->
    <linearGradient id="brandGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#E85A4F"/>
      <stop offset="100%" style="stop-color:#FF9472"/>
    </linearGradient>

    <!-- Accent Gradient -->
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7EC8A3"/>
      <stop offset="100%" style="stop-color:#4ADE7F"/>
    </linearGradient>

    <!-- Dark Gradient for dark mode -->
    <linearGradient id="darkGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2D3748"/>
      <stop offset="100%" style="stop-color:#1A1A2E"/>
    </linearGradient>
  </defs>

  <!-- ==================== -->
  <!-- VARIATION 1: Primary Logo with Icon -->
  <!-- ==================== -->
  <g id="primary-logo" transform="translate(50, 30)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">PRIMARY LOGO</text>

    <!-- Cart Icon -->
    <g transform="translate(0, 40)">
      <!-- Cart body - rounded, modern -->
      <path d="M12 25 L18 25 L22 65 C23 72 28 77 35 77 L75 77 C82 77 87 72 88 65 L95 30 L25 30"
            fill="none"
            stroke="url(#brandGradient)"
            stroke-width="5"
            stroke-linecap="round"
            stroke-linejoin="round"/>

      <!-- Cart handle -->
      <path d="M12 25 L5 10"
            fill="none"
            stroke="url(#brandGradient)"
            stroke-width="5"
            stroke-linecap="round"/>

      <!-- Cart wheels -->
      <circle cx="40" cy="90" r="8" fill="url(#brandGradient)"/>
      <circle cx="75" cy="90" r="8" fill="url(#brandGradient)"/>

      <!-- Speed lines / motion effect -->
      <line x1="0" y1="40" x2="15" y2="40" stroke="url(#accentGradient)" stroke-width="3" stroke-linecap="round" opacity="0.8"/>
      <line x1="-5" y1="52" x2="12" y2="52" stroke="url(#accentGradient)" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
      <line x1="0" y1="64" x2="10" y2="64" stroke="url(#accentGradient)" stroke-width="3" stroke-linecap="round" opacity="0.4"/>

      <!-- Items in cart (abstract shapes representing food) -->
      <circle cx="45" cy="50" r="10" fill="url(#accentGradient)" opacity="0.9"/>
      <circle cx="65" cy="48" r="8" fill="#FFB84D" opacity="0.9"/>
      <rect x="52" y="58" width="12" height="10" rx="2" fill="#E85A4F" opacity="0.7"/>
    </g>

    <!-- Wordmark -->
    <g transform="translate(110, 40)">
      <text x="0" y="55" font-family="system-ui, sans-serif" font-size="52" font-weight="800" fill="#1A1A2E" letter-spacing="-2">
        Go<tspan fill="url(#brandGradient)">,</tspan> Cart<tspan fill="url(#brandGradient)">!</tspan>
      </text>
    </g>
  </g>

  <!-- ==================== -->
  <!-- VARIATION 2: Icon Only (App Icon / Favicon) -->
  <!-- ==================== -->
  <g id="icon-only" transform="translate(500, 30)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">ICON ONLY</text>

    <!-- Circular background -->
    <circle cx="70" cy="90" r="55" fill="url(#brandGradient)"/>

    <!-- Simplified cart icon - white -->
    <g transform="translate(35, 55)">
      <path d="M8 18 L12 18 L15 48 C15.5 52 18 55 22 55 L52 55 C56 55 58.5 52 59 48 L64 22 L18 22"
            fill="none"
            stroke="white"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"/>
      <path d="M8 18 L3 8"
            fill="none"
            stroke="white"
            stroke-width="4"
            stroke-linecap="round"/>
      <circle cx="27" cy="63" r="5" fill="white"/>
      <circle cx="50" cy="63" r="5" fill="white"/>

      <!-- Checkmark in cart -->
      <path d="M28 35 L35 42 L48 28"
            fill="none"
            stroke="#7EC8A3"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"/>
    </g>
  </g>

  <!-- ==================== -->
  <!-- VARIATION 3: Horizontal Lockup (Dark Background) -->
  <!-- ==================== -->
  <g id="dark-mode" transform="translate(50, 180)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">DARK MODE VARIANT</text>

    <!-- Dark background -->
    <rect x="0" y="30" width="400" height="100" rx="12" fill="#1A1A2E"/>

    <!-- Cart Icon - Simplified -->
    <g transform="translate(25, 45)">
      <path d="M8 15 L12 15 L15 45 C15.5 50 19 53 24 53 L54 53 C59 53 62.5 50 63 45 L68 18 L18 18"
            fill="none"
            stroke="url(#brandGradient)"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"/>
      <path d="M8 15 L3 5"
            fill="none"
            stroke="url(#brandGradient)"
            stroke-width="4"
            stroke-linecap="round"/>
      <circle cx="28" cy="62" r="5" fill="url(#brandGradient)"/>
      <circle cx="52" cy="62" r="5" fill="url(#brandGradient)"/>

      <!-- Motion lines -->
      <line x1="-5" y1="25" x2="8" y2="25" stroke="#7EC8A3" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
      <line x1="-8" y1="35" x2="5" y2="35" stroke="#7EC8A3" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
    </g>

    <!-- Wordmark - White -->
    <text x="105" y="95" font-family="system-ui, sans-serif" font-size="38" font-weight="800" fill="white" letter-spacing="-1.5">
      Go<tspan fill="url(#brandGradient)">,</tspan> Cart<tspan fill="url(#brandGradient)">!</tspan>
    </text>
  </g>

  <!-- ==================== -->
  <!-- VARIATION 4: Stacked Logo -->
  <!-- ==================== -->
  <g id="stacked" transform="translate(500, 180)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">STACKED</text>

    <!-- Cart icon centered -->
    <g transform="translate(45, 35)">
      <path d="M8 18 L12 18 L15 48 C15.5 52 18 55 22 55 L52 55 C56 55 58.5 52 59 48 L64 22 L18 22"
            fill="none"
            stroke="url(#brandGradient)"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"/>
      <path d="M8 18 L3 8"
            fill="none"
            stroke="url(#brandGradient)"
            stroke-width="4"
            stroke-linecap="round"/>
      <circle cx="27" cy="63" r="5" fill="url(#brandGradient)"/>
      <circle cx="50" cy="63" r="5" fill="url(#brandGradient)"/>

      <!-- Accent items -->
      <circle cx="35" cy="38" r="7" fill="url(#accentGradient)" opacity="0.9"/>
      <circle cx="50" cy="36" r="5" fill="#FFB84D" opacity="0.9"/>
    </g>

    <!-- Wordmark below -->
    <text x="70" y="125" font-family="system-ui, sans-serif" font-size="28" font-weight="800" fill="#1A1A2E" letter-spacing="-1" text-anchor="middle">
      Go<tspan fill="url(#brandGradient)">,</tspan> Cart<tspan fill="url(#brandGradient)">!</tspan>
    </text>
  </g>

  <!-- ==================== -->
  <!-- VARIATION 5: Wordmark Only -->
  <!-- ==================== -->
  <g id="wordmark-only" transform="translate(50, 330)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">WORDMARK ONLY</text>

    <text x="0" y="85" font-family="system-ui, sans-serif" font-size="56" font-weight="800" fill="#1A1A2E" letter-spacing="-2">
      Go<tspan fill="url(#brandGradient)">,</tspan> Cart<tspan fill="url(#brandGradient)">!</tspan>
    </text>
  </g>

  <!-- ==================== -->
  <!-- VARIATION 6: Monochrome (for single-color use) -->
  <!-- ==================== -->
  <g id="monochrome" transform="translate(400, 330)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">MONOCHROME</text>

    <!-- All in brand coral -->
    <g transform="translate(0, 35)">
      <path d="M8 18 L12 18 L15 48 C15.5 52 18 55 22 55 L52 55 C56 55 58.5 52 59 48 L64 22 L18 22"
            fill="none"
            stroke="#E85A4F"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"/>
      <path d="M8 18 L3 8"
            fill="none"
            stroke="#E85A4F"
            stroke-width="4"
            stroke-linecap="round"/>
      <circle cx="27" cy="63" r="5" fill="#E85A4F"/>
      <circle cx="50" cy="63" r="5" fill="#E85A4F"/>
    </g>

    <text x="85" y="85" font-family="system-ui, sans-serif" font-size="38" font-weight="800" fill="#E85A4F" letter-spacing="-1.5">
      Go, Cart!
    </text>
  </g>

  <!-- ==================== -->
  <!-- VARIATION 7: Animated Icon Concept -->
  <!-- ==================== -->
  <g id="animated-concept" transform="translate(50, 460)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">ANIMATED CONCEPT (for web/app)</text>

    <!-- Cart with "GO" energy -->
    <g transform="translate(0, 30)">
      <!-- Background circle -->
      <circle cx="50" cy="50" r="48" fill="none" stroke="url(#brandGradient)" stroke-width="3" stroke-dasharray="8 4" opacity="0.3">
        <animateTransform attributeName="transform" type="rotate" from="0 50 50" to="360 50 50" dur="20s" repeatCount="indefinite"/>
      </circle>

      <!-- Cart -->
      <g transform="translate(15, 20)">
        <path d="M8 15 L12 15 L15 45 C15.5 50 19 53 24 53 L54 53 C59 53 62.5 50 63 45 L68 18 L18 18"
              fill="none"
              stroke="url(#brandGradient)"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"/>
        <path d="M8 15 L3 5"
              fill="none"
              stroke="url(#brandGradient)"
              stroke-width="4"
              stroke-linecap="round"/>
        <circle cx="28" cy="62" r="5" fill="url(#brandGradient)"/>
        <circle cx="52" cy="62" r="5" fill="url(#brandGradient)"/>

        <!-- Bouncing items in cart -->
        <circle cx="35" cy="35" r="8" fill="url(#accentGradient)">
          <animate attributeName="cy" values="35;30;35" dur="0.8s" repeatCount="indefinite"/>
        </circle>
        <circle cx="52" cy="33" r="6" fill="#FFB84D">
          <animate attributeName="cy" values="33;28;33" dur="0.8s" begin="0.2s" repeatCount="indefinite"/>
        </circle>
      </g>

      <!-- Speed lines with animation -->
      <g opacity="0.7">
        <line x1="5" y1="45" x2="20" y2="45" stroke="#7EC8A3" stroke-width="3" stroke-linecap="round">
          <animate attributeName="x1" values="5;0;5" dur="0.6s" repeatCount="indefinite"/>
          <animate attributeName="x2" values="20;15;20" dur="0.6s" repeatCount="indefinite"/>
        </line>
        <line x1="0" y1="55" x2="18" y2="55" stroke="#7EC8A3" stroke-width="3" stroke-linecap="round" opacity="0.6">
          <animate attributeName="x1" values="0;-5;0" dur="0.6s" begin="0.1s" repeatCount="indefinite"/>
          <animate attributeName="x2" values="18;13;18" dur="0.6s" begin="0.1s" repeatCount="indefinite"/>
        </line>
        <line x1="5" y1="65" x2="15" y2="65" stroke="#7EC8A3" stroke-width="3" stroke-linecap="round" opacity="0.4">
          <animate attributeName="x1" values="5;0;5" dur="0.6s" begin="0.2s" repeatCount="indefinite"/>
          <animate attributeName="x2" values="15;10;15" dur="0.6s" begin="0.2s" repeatCount="indefinite"/>
        </line>
      </g>
    </g>

    <!-- Wordmark -->
    <text x="120" y="95" font-family="system-ui, sans-serif" font-size="42" font-weight="800" fill="#1A1A2E" letter-spacing="-1.5">
      Go<tspan fill="url(#brandGradient)">,</tspan> Cart<tspan fill="url(#brandGradient)">!</tspan>
    </text>
  </g>

  <!-- ==================== -->
  <!-- Color Palette Reference -->
  <!-- ==================== -->
  <g id="color-reference" transform="translate(450, 460)">
    <text x="0" y="20" font-family="system-ui, sans-serif" font-size="12" fill="#857A6E" font-weight="500">COLOR REFERENCE</text>

    <rect x="0" y="35" width="50" height="50" rx="8" fill="#E85A4F"/>
    <text x="25" y="105" font-family="monospace" font-size="10" fill="#635A50" text-anchor="middle">#E85A4F</text>
    <text x="25" y="118" font-family="system-ui, sans-serif" font-size="9" fill="#857A6E" text-anchor="middle">Primary</text>

    <rect x="65" y="35" width="50" height="50" rx="8" fill="#1A1A2E"/>
    <text x="90" y="105" font-family="monospace" font-size="10" fill="#635A50" text-anchor="middle">#1A1A2E</text>
    <text x="90" y="118" font-family="system-ui, sans-serif" font-size="9" fill="#857A6E" text-anchor="middle">Secondary</text>

    <rect x="130" y="35" width="50" height="50" rx="8" fill="#7EC8A3"/>
    <text x="155" y="105" font-family="monospace" font-size="10" fill="#635A50" text-anchor="middle">#7EC8A3</text>
    <text x="155" y="118" font-family="system-ui, sans-serif" font-size="9" fill="#857A6E" text-anchor="middle">Accent</text>

    <rect x="195" y="35" width="50" height="50" rx="8" fill="#FAF7F5" stroke="#E2DBD4"/>
    <text x="220" y="105" font-family="monospace" font-size="10" fill="#635A50" text-anchor="middle">#FAF7F5</text>
    <text x="220" y="118" font-family="system-ui, sans-serif" font-size="9" fill="#857A6E" text-anchor="middle">Background</text>
  </g>

</svg>
