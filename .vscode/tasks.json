{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start All Services",
      "type": "shell",
      "command": "docker-compose up -d",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Stop All Services",
      "type": "shell",
      "command": "docker-compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Rebuild and Start",
      "type": "shell",
      "command": "docker-compose up --build -d",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: View API Logs",
      "type": "shell",
      "command": "docker logs -f recipe-api",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: View All Logs",
      "type": "shell",
      "command": "docker-compose logs -f",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test: Run All Tests",
      "type": "shell",
      "command": "docker exec -it recipe-api pytest tests/ -v",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test: Run Tests with Coverage",
      "type": "shell",
      "command": "docker exec -it recipe-api pytest tests/ --cov=app --cov-report=html --cov-report=term",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test: Run Specific Test File",
      "type": "shell",
      "command": "docker exec -it recipe-api pytest ${relativeFile} -v",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Database: Run Migrations",
      "type": "shell",
      "command": "docker exec -it recipe-api alembic upgrade head",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Database: Create New Migration",
      "type": "shell",
      "command": "docker exec -it recipe-api alembic revision --autogenerate -m \"${input:migrationMessage}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Database: Rollback Migration",
      "type": "shell",
      "command": "docker exec -it recipe-api alembic downgrade -1",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Database: Reset Database",
      "type": "shell",
      "command": "docker-compose down -v && docker-compose up -d db && sleep 5 && docker exec -it recipe-api alembic upgrade head",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Lint: Run Black (Format)",
      "type": "shell",
      "command": "docker exec -it recipe-api black app/ tests/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Lint: Run Flake8",
      "type": "shell",
      "command": "docker exec -it recipe-api flake8 app/ tests/ --max-line-length=120",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Lint: Run MyPy",
      "type": "shell",
      "command": "docker exec -it recipe-api mypy app/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Lint: Run All Checks",
      "type": "shell",
      "command": "docker exec -it recipe-api sh -c 'black app/ tests/ && flake8 app/ tests/ --max-line-length=120 && mypy app/'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Shell: Enter API Container",
      "type": "shell",
      "command": "docker exec -it recipe-api /bin/sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Shell: PostgreSQL CLI",
      "type": "shell",
      "command": "docker exec -it recipe-postgres psql -U postgres recipe_app",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Shell: Redis CLI",
      "type": "shell",
      "command": "docker exec -it recipe-redis redis-cli",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Monitoring: Open Grafana",
      "type": "shell",
      "command": "open http://localhost:3000 || xdg-open http://localhost:3000",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Monitoring: Open Prometheus",
      "type": "shell",
      "command": "open http://localhost:9090 || xdg-open http://localhost:9090",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "API: Open Swagger Docs",
      "type": "shell",
      "command": "open http://localhost:8000/api/docs || xdg-open http://localhost:8000/api/docs",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationMessage",
      "type": "promptString",
      "description": "Enter migration message:",
      "default": "add new field"
    }
  ]
}
